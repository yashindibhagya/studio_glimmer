ADMIN_EMAIL=you@example.com
# Generate with: npm run hash-password -- "your-password"   (escape each $ as \$ in .env files)
ADMIN_PASSWORD_HASH=
# Any random string of 32+ characters: openssl rand -hex 32
SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=https://studioglimmer.lk
# Firebase → Project settings → Service accounts → Generate new private key (JSON file)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Cloudinary → Dashboard (API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
